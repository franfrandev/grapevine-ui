{
  "name": "libp2p-webrtc-guide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "associated code for the libp2p webrtc guide",
  "license": "ISC",
  "scripts": {
    "clean": "rimraf ./dist",
    "build:dev": "mkdir -p dist && ln -fs ../src/index.html dist/index.html",
    "build": "mkdir -p dist && tsx ./esbuild.ts",
    "test": "tsx --test src/peer_discovery.test.ts",
    "start": "npm run build:dev && tsx ./esbuild.ts --serve",
    "start:relay": "tsx --trace-warnings src/relay.ts"
  },
  "devDependencies": {
    "@libp2p/interface": "^3.4.0",
    "esbuild": "^0.28.2",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "eslintConfig": {
    "extends": "ipfs",
    "parserOptions": {
      "sourceType": "module"
    }
  },
  "dependencies": {
    "@chainsafe/libp2p-gossipsub": "^14.1.1",
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@libp2p/autonat": "^3.0.30",
    "@libp2p/bootstrap": "^12.0.34",
    "@libp2p/circuit-relay-v2": "^4.2.15",
    "@libp2p/gossipsub": "^17.1.4",
    "@libp2p/identify": "^4.1.16",
    "@libp2p/interface-connection": "^5.1.1",
    "@libp2p/keychain": "^6.1.8",
    "@libp2p/logger": "^6.2.15",
    "@libp2p/pubsub-peer-discovery": "^12.0.0",
    "@libp2p/tcp": "^11.0.30",
    "@libp2p/utils": "^7.4.3",
    "@libp2p/webrtc": "^7.0.0",
    "@libp2p/websockets": "^10.1.23",
    "@libp2p/webtransport": "^6.0.42",
    "@multiformats/multiaddr": "^13.0.3",
    "@multiformats/multiaddr-matcher": "^3.0.2",
    "datastore-level": "^13.0.1",
    "libp2p": "3.4.0",
    "rtp.js": "^0.15.7",
    "uint8arrays": "^6.1.1"
  }
}
